(export (version "E")
  (design
    (source "carpi-can")
    (tool "hand-written; see hardware/README.md")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "car-pi MCP2515 CAN interface")
        (company "car-pi")
        (comment (number "1") (value "MCP2515 CAN 2.0B controller + SN65HVD230 3.3V transceiver."))
        (comment (number "2") (value "Pin numbers verified against Microchip DS20001801K, 18-lead PDIP."))
        (comment (number "3") (value "NO 120 ohm terminator: a vehicle bus is already terminated at both ends."))
        (comment (number "4") (value "NOT YET BUILT. Check against the datasheets before soldering.")))))
  (components
    (comp (ref "U1")
      (value "MCP2515")
      (footprint "Package_DIP:DIP-18_W7.62mm")
      (description "Stand-alone CAN 2.0B controller, SPI. 18-lead PDIP.")
      (property (name "Datasheet") (value "https://ww1.microchip.com/downloads/aemDocuments/documents/APID/ProductDocuments/DataSheets/MCP2515-Family-Data-Sheet-DS20001801K.pdf"))
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "U2")
      (value "SN65HVD230")
      (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm")
      (description "3.3V CAN transceiver. 3.3V operation is why no level shifting is needed.")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "Y1")
      (value "16MHz")
      (footprint "Crystal:Crystal_HC49-4H_Vertical")
      (description "MCP2515 clock. MUST match oscillator= in the dtoverlay.")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "C1")
      (value "22pF")
      (footprint "Capacitor_THT:C_Disc_D3.0mm_W1.6mm_P2.50mm")
      (description "Crystal load capacitor")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "C2")
      (value "22pF")
      (footprint "Capacitor_THT:C_Disc_D3.0mm_W1.6mm_P2.50mm")
      (description "Crystal load capacitor")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "C3")
      (value "100nF")
      (footprint "Capacitor_THT:C_Disc_D3.0mm_W1.6mm_P2.50mm")
      (description "U1 decoupling, as close to pin 18 as possible")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "C4")
      (value "100nF")
      (footprint "Capacitor_THT:C_Disc_D3.0mm_W1.6mm_P2.50mm")
      (description "U2 decoupling, as close to pin 3 as possible")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "R1")
      (value "10k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm")
      (description "RESET pull-up")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "R2")
      (value "10k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P7.62mm")
      (description "RS to GND selects high-speed mode on the transceiver")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "D1")
      (value "PESD1CAN")
      (footprint "Package_TO_SOT_SMD:SOT-23")
      (description "Bidirectional TVS across the CAN pair. It is going in a car.")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "J1")
      (value "OBD-II harness")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical")
      (description "To J1962 pigtail: 1=pin6 CAN_H, 2=pin14 CAN_L, 3=pin4/5 GND. DO NOT wire J1962 pin 16.")
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "J2")
      (value "Pi GPIO")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x07_P2.54mm_Vertical")
      (description "To Raspberry Pi 40-pin header: 3V3, GND, MOSI, MISO, SCLK, CE0, GPIO25")
      (sheetpath (names "/") (tstamps "/"))))
  (nets
    (net (code "1") (name "+3V3")
      (node (ref "U1") (pin "18") (pinfunction "VDD") (pintype "power_in"))
      (node (ref "U2") (pin "3") (pinfunction "VCC") (pintype "power_in"))
      (node (ref "C3") (pin "1") (pintype "passive"))
      (node (ref "C4") (pin "1") (pintype "passive"))
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "J2") (pin "1") (pintype "passive")))
    (net (code "2") (name "GND")
      (node (ref "U1") (pin "9") (pinfunction "VSS") (pintype "power_in"))
      (node (ref "U2") (pin "2") (pinfunction "GND") (pintype "power_in"))
      (node (ref "C1") (pin "2") (pintype "passive"))
      (node (ref "C2") (pin "2") (pintype "passive"))
      (node (ref "C3") (pin "2") (pintype "passive"))
      (node (ref "C4") (pin "2") (pintype "passive"))
      (node (ref "R2") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "3") (pintype "passive"))
      (node (ref "J1") (pin "3") (pintype "passive"))
      (node (ref "J2") (pin "2") (pintype "passive")))
    (net (code "3") (name "SPI_MOSI")
      (node (ref "U1") (pin "14") (pinfunction "SI") (pintype "input"))
      (node (ref "J2") (pin "3") (pintype "passive")))
    (net (code "4") (name "SPI_MISO")
      (node (ref "U1") (pin "15") (pinfunction "SO") (pintype "output"))
      (node (ref "J2") (pin "4") (pintype "passive")))
    (net (code "5") (name "SPI_SCLK")
      (node (ref "U1") (pin "13") (pinfunction "SCK") (pintype "input"))
      (node (ref "J2") (pin "5") (pintype "passive")))
    (net (code "6") (name "SPI_CS")
      (node (ref "U1") (pin "16") (pinfunction "CS") (pintype "input"))
      (node (ref "J2") (pin "6") (pintype "passive")))
    (net (code "7") (name "MCP_INT")
      (node (ref "U1") (pin "12") (pinfunction "INT") (pintype "output"))
      (node (ref "J2") (pin "7") (pintype "passive")))
    (net (code "8") (name "MCP_RESET")
      (node (ref "U1") (pin "17") (pinfunction "RESET") (pintype "input"))
      (node (ref "R1") (pin "2") (pintype "passive")))
    (net (code "9") (name "OSC2")
      (node (ref "U1") (pin "7") (pinfunction "OSC2") (pintype "output"))
      (node (ref "Y1") (pin "1") (pintype "passive"))
      (node (ref "C1") (pin "1") (pintype "passive")))
    (net (code "10") (name "OSC1")
      (node (ref "U1") (pin "8") (pinfunction "OSC1") (pintype "input"))
      (node (ref "Y1") (pin "2") (pintype "passive"))
      (node (ref "C2") (pin "1") (pintype "passive")))
    (net (code "11") (name "TXCAN")
      (node (ref "U1") (pin "1") (pinfunction "TXCAN") (pintype "output"))
      (node (ref "U2") (pin "1") (pinfunction "D") (pintype "input")))
    (net (code "12") (name "RXCAN")
      (node (ref "U1") (pin "2") (pinfunction "RXCAN") (pintype "input"))
      (node (ref "U2") (pin "4") (pinfunction "R") (pintype "output")))
    (net (code "13") (name "CAN_H")
      (node (ref "U2") (pin "7") (pinfunction "CANH") (pintype "bidirectional"))
      (node (ref "D1") (pin "1") (pintype "passive"))
      (node (ref "J1") (pin "1") (pintype "passive")))
    (net (code "14") (name "CAN_L")
      (node (ref "U2") (pin "6") (pinfunction "CANL") (pintype "bidirectional"))
      (node (ref "D1") (pin "2") (pintype "passive"))
      (node (ref "J1") (pin "2") (pintype "passive")))
    (net (code "15") (name "TRANSCEIVER_RS")
      (node (ref "U2") (pin "8") (pinfunction "RS") (pintype "input"))
      (node (ref "R2") (pin "1") (pintype "passive")))
    (net (code "16") (name "unconnected-(U1-CLKOUT-Pad3)")
      (node (ref "U1") (pin "3") (pinfunction "CLKOUT/SOF") (pintype "output+no_connect")))
    (net (code "17") (name "unconnected-(U1-TX0RTS-Pad4)")
      (node (ref "U1") (pin "4") (pinfunction "TX0RTS") (pintype "input+no_connect")))
    (net (code "18") (name "unconnected-(U1-TX1RTS-Pad5)")
      (node (ref "U1") (pin "5") (pinfunction "TX1RTS") (pintype "input+no_connect")))
    (net (code "19") (name "unconnected-(U1-TX2RTS-Pad6)")
      (node (ref "U1") (pin "6") (pinfunction "TX2RTS") (pintype "input+no_connect")))
    (net (code "20") (name "unconnected-(U1-RX1BF-Pad10)")
      (node (ref "U1") (pin "10") (pinfunction "RX1BF") (pintype "output+no_connect")))
    (net (code "21") (name "unconnected-(U1-RX0BF-Pad11)")
      (node (ref "U1") (pin "11") (pinfunction "RX0BF") (pintype "output+no_connect")))
    (net (code "22") (name "unconnected-(U2-Vref-Pad5)")
      (node (ref "U2") (pin "5") (pinfunction "Vref") (pintype "output+no_connect")))))
