.DS_Store

# Captured vehicle data. Raw logs contain the VIN, which identifies a real car
# and its owner -- never commit these casually. Curated, VIN-scrubbed fixtures
# belong in tests/fixtures/ and are committed deliberately.
scans/
*.candump
*.asc
*.blf

# Names the tool suggests by default, in case one is written inside a checkout.
# A backstop, not the protection: reports and sweeps default to a path under
# ~/.carpi and are written owner-only. See carpi/core/storage.py.
carpi-scan-*.json
contribution-*.json
